# すべてサーバー専用。NEXT_PUBLIC_付きの変数にはしない。
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/postgres?sslmode=verify-full
DATABASE_POOL_MAX=5
# 必要な場合、Supabase公式のCA証明書のPEM文字列を設定する。証明書検証は有効のままにする。
DATABASE_SSL_CA=
APP_ORIGIN=https://YOUR-APP.example.com
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=YOUR-PUBLISHABLE-OR-ANON-KEY
PEDIGREE_ALLOWED_EMAILS=owner@example.com,staff@example.com
# 32文字以上のランダムな秘密鍵。
PEDIGREE_SESSION_SECRET=
# 初期状態では閲覧のみ。別DBでの確認を終えた後、登録開始時に1へ変更する。
PEDIGREE_WRITES_ENABLED=0
